# Copy to .env for local runs. In CI these come from GitHub Actions Secrets.
# NEVER commit real values.

# OpenAI — writes the lesson script.
OPENAI_API_KEY=

# TTS engine: 'elevenlabs' (more human, paid) or 'google' (native Thai, free).
# On an ElevenLabs error (e.g. quota) the pipeline auto-falls back to Google.
TTS_PROVIDER=elevenlabs

# ElevenLabs API key (only needed when TTS_PROVIDER=elevenlabs).
ELEVENLABS_API_KEY=

# Google Cloud service-account JSON for Text-to-Speech (also the fallback).
# Local: path to the JSON file. CI: the JSON contents are written to a file by the workflow.
GOOGLE_APPLICATION_CREDENTIALS=./google-tts-key.json

# GitHub token for uploading MP3s to Releases. In CI this is the built-in GITHUB_TOKEN.
GITHUB_TOKEN=

# Public site base, e.g. https://USER.github.io/thai-class
SITE_BASE_URL=

# owner/repo, e.g. yourname/thai-class — used for the Releases API.
GITHUB_REPO=

# Real email that appears in the feed. Spotify sends the verification code here.
PODCAST_OWNER_EMAIL=
