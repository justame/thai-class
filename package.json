{
  "name": "thai-class",
  "version": "1.0.0",
  "description": "Daily Thai learning podcast generator, auto-published to Spotify via RSS",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "seed": "tsc && node dist/scripts/seed.js",
    "tag": "tsc && node dist/scripts/tag-obvious.js",
    "audit": "tsc && node dist/scripts/audit.js",
    "text": "tsc && node dist/scripts/text.js",
    "audio": "tsc && node dist/scripts/audio.js",
    "smoke": "tsc && node dist/scripts/smoke.js",
    "start": "tsc && node dist/src/run.js",
    "cover": "tsc && node dist/src/cover.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "^5.3.0",
    "@octokit/rest": "^21.0.0",
    "dotenv": "^16.4.0",
    "ffmpeg-static": "^5.3.0",
    "openai": "^4.67.0",
    "podcast": "^2.0.1",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/podcast": "^1.3.5",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9"
  }
}
